---
import Logo from "./Logo.astro";
import { ORG, EMAIL, repos } from "../data/site";
import type { Lang } from "../i18n/strings";
import { strings } from "../i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const f = strings[lang].footer;
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800 bg-ink-900">
  <div class="wrap flex flex-col gap-8 py-10 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <Logo />
      <p class="mt-3 text-sm text-ink-400">{f.tagline}</p>
    </div>
    <ul class="grid grid-cols-2 gap-x-10 gap-y-2 font-mono text-xs text-ink-300">
      <li><a class="hover:text-signal-400" href={repos.openTARS}>openTARS</a></li>
      <li><a class="hover:text-signal-400" href={ORG}>GitHub</a></li>
      <li><a class="hover:text-signal-400" href={repos.openISP}>openISP</a></li>
      <li><a class="hover:text-signal-400" href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
    </ul>
  </div>
  <div class="wrap flex flex-col gap-2 border-t border-ink-800 py-5 font-mono text-[11px] text-ink-400 sm:flex-row sm:justify-between">
    <span>© {year} CruxOpen</span>
    <span>{f.licenses}</span>
  </div>
</footer>
