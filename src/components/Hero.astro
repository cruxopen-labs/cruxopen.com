---
import { heroFacts } from "../data/site";
import type { Lang } from "../i18n/strings";
import { strings } from "../i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
const keys = ["tarsDecode", "tarsExact", "ispVideo", "tarsMutants"] as const;
const facts = keys.map((k) => {
  const f = heroFacts[k];
  const l = t.facts[k] as { label: string; unit: string; value?: string };
  return { key: k, value: l.value ?? f.value, unit: l.unit, label: l.label, src: f.src };
});
---

<section class="relative overflow-hidden border-b border-ink-800">
  <div class="grid-bg pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_top_left,black_30%,transparent_75%)]" aria-hidden="true"></div>

  <div class="wrap relative pb-16 pt-16 sm:pb-20 sm:pt-24 lg:pt-28">
    <p class="eyebrow flex items-center gap-2">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-signal-500"></span>
      {t.hero.eyebrow}
    </p>

    <h1 class="mt-6 max-w-4xl text-[2.6rem] font-semibold leading-[1.02] tracking-[-0.03em] text-ink-100 sm:text-6xl lg:text-7xl">
      {t.hero.title1}<br />
      <span class="text-signal-500">{t.hero.title2}</span>
    </h1>

    <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-300 sm:text-lg">{t.hero.lead}</p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a href="#projects" class="btn-primary">
        {t.hero.ctaProjects}
        <span aria-hidden="true">↓</span>
      </a>
      <a href="#collaborate" class="btn-ghost">{t.hero.ctaContact}</a>
    </div>

    <div class="mt-16 sm:mt-20">
      <p class="eyebrow">{t.hero.factsLabel}</p>
      <dl class="mt-4 grid grid-cols-2 border-l border-t border-ink-700 lg:grid-cols-4">
        {facts.map((f) => (
          <div class="border-b border-r border-ink-700 bg-ink-950/80 p-4 sm:p-5">
            <dt class="text-[13px] leading-snug text-ink-400">{f.label}</dt>
            <dd class="mt-3">
              <span class="num font-mono text-2xl font-medium text-ink-100 sm:text-3xl">{f.value}</span>
              <span class="mt-1 block font-mono text-xs text-signal-400">{f.unit}</span>
            </dd>
            <dd class="mt-3 font-mono text-[10px] leading-snug text-ink-400/80" title={f.src}>
              ↳ {f.src}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
