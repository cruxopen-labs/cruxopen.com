---
// The mark: a die outline with a crux (cross) of routed traces meeting at a pad.
interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="2.5" y="2.5" width="19" height="19" rx="1.5" stroke="currentColor" stroke-opacity="0.45" />
    <path d="M12 2.5V9.5M12 14.5V21.5M2.5 12H9.5M14.5 12H21.5" stroke="var(--color-signal-500)" stroke-width="1.6" />
    <rect x="9.5" y="9.5" width="5" height="5" fill="var(--color-signal-500)" />
  </svg>
  <span class="font-mono text-[13px] font-semibold tracking-[0.2em] text-ink-100">CRUXOPEN</span>
</span>
