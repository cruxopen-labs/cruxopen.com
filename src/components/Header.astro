---
import Logo from "./Logo.astro";
import { ORG } from "../data/site";
import type { Lang } from "../i18n/strings";
import { strings } from "../i18n/strings";

interface Props {
  lang: Lang;
  /** Where the language switch goes; the other language's home page by default. */
  altHref?: string;
  /** Which nav item is the current page. */
  current?: "blog";
}
const { lang, altHref, current } = Astro.props;
const n = strings[lang].nav;
const home = lang === "zh" ? "/zh/" : "/";
// Section links carry the home path so they also work from the blog pages.
const links = [
  { href: `${home}#projects`, label: n.projects },
  { href: `${home}#method`, label: n.method },
  { href: `${home}blog/`, label: n.blog, key: "blog" },
  { href: `${home}#collaborate`, label: n.collaborate },
];
---

<header class="sticky top-0 z-40 border-b border-ink-800/80 bg-ink-950/85 backdrop-blur supports-[backdrop-filter]:bg-ink-950/70">
  <div class="wrap flex h-14 items-center justify-between gap-4">
    <a href={home} aria-label="CruxOpen home"><Logo /></a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7 text-sm text-ink-300">
        {links.map((l) => (
          <li>
            <a
              class:list={["transition-colors hover:text-ink-100", l.key === current && "text-ink-100 underline decoration-signal-500 decoration-2 underline-offset-[6px]"]}
              aria-current={l.key === current ? "page" : undefined}
              href={l.href}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={`${home}blog/`}
        class="rounded-sm px-2.5 py-1.5 text-sm text-ink-300 transition-colors hover:bg-ink-850 hover:text-ink-100 md:hidden"
      >{n.blog}</a>
      <a
        href={altHref ?? n.langHref}
        hreflang={lang === "zh" ? "en" : "zh-CN"}
        class="rounded-sm px-2.5 py-1.5 font-mono text-xs text-ink-300 transition-colors hover:bg-ink-850 hover:text-ink-100"
      >{n.lang}</a>
      <a
        href={ORG}
        aria-label="CruxOpen on GitHub"
        class="rounded-sm p-2 text-ink-300 transition-colors hover:bg-ink-850 hover:text-ink-100"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
        </svg>
      </a>
    </div>
  </div>
</header>
